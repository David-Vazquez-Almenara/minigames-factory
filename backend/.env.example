# Copia este archivo como .env (no se sube al repositorio) para desarrollo local.
#
# Puerto del servidor. En Render no hace falta: Render define PORT automaticamente.
PORT=3000
#
# URL(s) del frontend que pueden conectarse al backend (CORS de HTTP y Socket.IO), separadas por comas.
CLIENT_ORIGIN=http://localhost:4200,http://127.0.0.1:4200
#
# Produccion (Render): NO hace falta este archivo y Render lo ignora. Define en
# Render > tu servicio > Environment la variable:
#   CLIENT_ORIGIN=https://tu-sitio.netlify.app
# Si falta, el servidor no arranca (para no quedarse aceptando solo localhost sin avisar).
